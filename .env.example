# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Database Configuration
# SQLite (default): sqlite:///path/to/archive.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost/wumpus
DATABASE_URL=sqlite:///./wumpus_archive.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false

# Scraper Configuration
BATCH_SIZE=1000
RATE_LIMIT_DELAY=0.5
MAX_RETRIES=5
DOWNLOAD_ATTACHMENTS=true
ATTACHMENTS_PATH=./attachments

# Chat mirror bridge (`wumpus-archiver mirror`)
CHAT_BRIDGE_URL=https://connect.apehost.net/dashboard/chat/bridge
CHAT_BRIDGE_TOKEN=
# Cloudflare Access service token for edge passage to the bridge path (optional
# if the host is not behind Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Portal Configuration
PORTAL_TITLE=Wumpus Archiver
PORTAL_DESCRIPTION=Discord Server Archive
DEFAULT_PAGE_SIZE=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/wumpus.log
